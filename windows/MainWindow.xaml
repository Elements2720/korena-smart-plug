<Window x:Class="HomeStrip.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Home Strip" Width="340" Height="310" MinWidth="310" MinHeight="290" Background="#EEF2F4" Closing="OnClosing">
  <Grid Margin="16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel><TextBlock Text="Home Strip" FontSize="20" FontWeight="SemiBold" Foreground="#182D38"/><CheckBox x:Name="Pin" Content="On top" HorizontalAlignment="Right" VerticalAlignment="Center" Checked="PinChanged" Unchecked="PinChanged"/></DockPanel>
    <TextBlock x:Name="Status" Grid.Row="1" Text="Connecting…" Margin="0,8,0,10" TextWrapping="Wrap" Foreground="#526570" AutomationProperties.LiveSetting="Polite"/>
    <UniformGrid x:Name="Outlets" Grid.Row="2" Rows="2" Columns="2"/>
    <DockPanel Grid.Row="3" Margin="0,10,0,0"><Button Content="Settings" Click="OpenSettings" Padding="8,4"/><Button Content="To tray" Click="ToTray" Padding="8,4" Margin="8,0,0,0"/><TextBlock x:Name="Power" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel>
  </Grid>
</Window>
